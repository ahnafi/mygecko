{
  "lsp": {
    "arduino-language-server": {
      "initialization_options": {
        "autoCreateConfig": true,
      },
      "binary": {
        "arguments": [
          "-cli-config",
          "~/.arduino15/arduino-cli.yaml",
          "-fqbn",
          "esp32:esp32:esp32doit-devkit-v1",
        ],
      },
    },
  },
}
